#supabase configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-anon-key

# backend server
PORT=4000
FRONTEND_ORIGIN=http://localhost:5173

# Transactional SMTP (use a demo/sandbox sender, never a personal mailbox)
SMTP_HOST=sandbox.smtp.mailtrap.io
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM_EMAIL=no-reply@your-demo-domain.example

# Local-only Gmail fallback when SMTP_HOST is empty
GMAIL_USER=
GMAIL_APP_PASSWORD=

# Required in production to protect /api/email/send with x-api-key
MAIL_API_KEY=

# Supabase Admin (REQUIRED for signup verification & forgot password email flow)
# Get this from: Supabase Dashboard → Settings → API → service_role key (secret)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# mail & redirect settings
MAIL_FROM_NAME=ReMarket
SIGNUP_CONFIRM_PATH=/login
RESET_PASSWORD_PATH=/reset-password
SIGNUP_COOLDOWN_SECONDS=90
FORGOT_PASSWORD_COOLDOWN_SECONDS=60
AUTH_EMAIL_RATE_LIMIT_WINDOW_MS=900000
AUTH_EMAIL_RATE_LIMIT_MAX=10
API_RATE_LIMIT_WINDOW_MS=900000
API_RATE_LIMIT_MAX=300
READINESS_TIMEOUT_MS=3000

# Portfolio demo safety: admin can inspect data but cannot mutate it or issue refunds
DEMO_READ_ONLY_ADMIN=false

# Seed credentials must be supplied as deployment secrets (minimum 12 characters)
DEMO_ADMIN_EMAIL=admin@test.com
DEMO_ADMIN_PASSWORD=
DEMO_AGENT_EMAIL=agent@test.com
DEMO_AGENT_PASSWORD=
DEMO_SELLER_EMAIL=seller@test.com
DEMO_BUYER_EMAIL=buyer@test.com
DEMO_BOTH_EMAIL=both@test.com
DEMO_CUSTOMER_PASSWORD=

# Payment gateways
PAYMENT_RETURN_URL=http://localhost:5173/payment/return
PAYMENT_NOTIFY_URL=http://localhost:4000/api/payment/ipn/momo

# MoMo sandbox
MOMO_PARTNER_CODE=
MOMO_ACCESS_KEY=
MOMO_SECRET_KEY=
MOMO_PARTNER_NAME=ReMarket
MOMO_STORE_ID=ReMarketStore
MOMO_REQUEST_TYPE=captureWallet
MOMO_CREATE_ENDPOINT=https://test-payment.momo.vn/v2/gateway/api/create
MOMO_QUERY_ENDPOINT=https://test-payment.momo.vn/v2/gateway/api/query

# VNPAY sandbox
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_PAYMENT_ENDPOINT=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_QUERY_ENDPOINT=https://sandbox.vnpayment.vn/merchant_webapi/api/transaction
VNPAY_VERSION=2.1.0
VNPAY_CURR_CODE=VND
VNPAY_LOCALE=vn
VNPAY_ORDER_TYPE=other

# AI support chat (optional)
# AI_PROVIDER can be groq, gemini, or openai. Leave empty to auto-pick the first configured key.
# If no provider key is configured, /api/ai-support/chat still works in retrieval fallback mode.
AI_PROVIDER=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-nano
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
